# PHP SAT Scraper Configuration
APP_ENV=production
APP_DEBUG=false

# Captcha Resolver Configuration
CAPTCHA_RESOLVER_SERVICE=boxfactura
CAPTCHA_RESOLVER_TOKEN=your_boxfactura_token_here

# Storage Configuration
STORAGE_PATH=./storage/cfdis

# Security
API_KEY=your_secure_api_key_here

# Logging
LOG_LEVEL=info
LOG_PATH=./logs

# Rate Limiting
MAX_QUERIES_PER_REQUEST=500
SPLIT_BY_DAY=true

