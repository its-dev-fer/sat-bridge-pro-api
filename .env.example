# ===== SERVER CONFIGURATION =====
# Environment: dev | prod
APP_ENV=dev
# Server host
APP_HOST=0.0.0.0
# Server port
APP_PORT=3000
# Base URL for the application
APP_URL=http://localhost:3000

# ===== DATABASE CONFIGURATION =====
# Database host
DB_HOST=postgresdb
# Database user
DB_USER=postgres
# Database password (CHANGE THIS IN PRODUCTION)
DB_PASSWORD=your_secure_password_here
# Database name
DB_NAME=fiberdb
# Database port
DB_PORT=5432

# ===== JWT CONFIGURATION =====
# JWT secret key (MUST be at least 32 characters long)
JWT_SECRET=your_very_long_jwt_secret_key_minimum_32_characters_here
# Access token expiration in minutes
JWT_ACCESS_EXP_MINUTES=30
# Refresh token expiration in days
JWT_REFRESH_EXP_DAYS=30
# Reset password token expiration in minutes
JWT_RESET_PASSWORD_EXP_MINUTES=10
# Verify email token expiration in minutes
JWT_VERIFY_EMAIL_EXP_MINUTES=10

# ===== EMAIL CONFIGURATION =====
# SMTP server host
SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP server port
SMTP_PORT=2525
# SMTP username
SMTP_USERNAME=your_smtp_username_here
# SMTP password
SMTP_PASSWORD=your_smtp_password_here
# Default sender email
EMAIL_FROM=support@yourapp.com

# ===== OAUTH CONFIGURATION =====
# Google OAuth Client ID
GOOGLE_CLIENT_ID=your_google_client_id_here
# Google OAuth Client Secret
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# OAuth redirect URL
REDIRECT_URL=http://localhost:3000/v1/auth/google-callback

# ===== PHP SAT SCRAPER CONFIGURATION =====
# API Key for PHP SAT Scraper service
PHP_SAT_SCRAPER_API_KEY=your_php_scraper_api_key_here
# Token for captcha resolver service (BoxFactura, 2Captcha, etc.)
CAPTCHA_RESOLVER_TOKEN=your_captcha_resolver_token_here

# ===== OPTIONAL CONFIGURATION =====
# Uncomment and configure if needed:

# # PHP SAT Scraper URL
 PHP_SAT_SCRAPER_URL=http://php-scraper:80

# # Application name
APP_NAME=SAT Bridge Pro API

# # Log level: debug | info | warn | error
 LOG_LEVEL=info

# # CORS allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# # Rate limiting
RATE_LIMIT=100
RATE_LIMIT_EXPIRATION=3600